{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ordermate-test",
  "main": "src/worker/main-xero.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_DOCUMENT_EXTRACTION_ENABLED": "false",
    "AI_OPERATIONS_ASSISTANT_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "ordermate-control-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/control"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_STORES",
        "class_name": "TenantStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TenantStore"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "ordermate-documents-test"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "ordermate-events-test"
      }
    ],
    "consumers": [
      {
        "queue": "ordermate-events-test",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 30,
        "dead_letter_queue": "ordermate-events-dead-test"
      }
    ]
  }
}

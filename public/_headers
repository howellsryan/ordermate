# The staging SPA is served by Cloudflare Static Assets rather than the Worker
# so the public landing route cannot accidentally fall through to the API 404.
# Keep staging non-indexable and non-cacheable on the compatibility hostname.
https://ordermate-staging.rlh.workers.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
